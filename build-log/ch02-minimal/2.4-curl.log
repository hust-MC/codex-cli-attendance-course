$ curl -sS http://127.0.0.1:3000/api/health
{"code":200,"data":null,"message":"服务正常"}

HTTP_STATUS=200
$ curl -X POST /api/employees (创建张三)
{"code":200,"data":{"created_at":"2026-11-03 11:38:09","department":"研发部","employee_no":"E001","id":1,"name":"张三"},"message":"员工创建成功"}

HTTP_STATUS=200
$ curl -X POST /api/employees (重复工号)
{"code":400,"data":null,"message":"工号已存在"}

HTTP_STATUS=400
$ curl GET /api/employees
{"code":200,"data":{"items":[{"created_at":"2026-11-03 11:38:09","department":"研发部","employee_no":"E001","id":1,"name":"张三"}],"total":1},"message":"操作成功"}

HTTP_STATUS=200
$ curl GET /api/employees/1
{"code":200,"data":{"created_at":"2026-11-03 11:38:09","department":"研发部","employee_no":"E001","id":1,"name":"张三"},"message":"操作成功"}

HTTP_STATUS=200
$ curl -X PUT /api/employees/1
{"code":200,"data":{"created_at":"2026-11-03 11:38:09","department":"平台研发部","employee_no":"E001","id":1,"name":"张三"},"message":"员工信息已更新"}

HTTP_STATUS=200
$ curl -X POST /api/checkins/in
{"code":200,"data":{"check_time":"2026-11-03 08:55:00","check_type":"in","employee_id":1,"id":1},"message":"签到成功"}

HTTP_STATUS=200
$ curl -X POST /api/checkins/in (重复签到)
{"code":400,"data":null,"message":"当天已经签到，不能重复操作"}

HTTP_STATUS=400
$ curl -X POST /api/checkins/out
{"code":200,"data":{"check_time":"2026-11-03 18:05:00","check_type":"out","employee_id":1,"id":2},"message":"签出成功"}

HTTP_STATUS=200
$ curl GET /api/checkins?employee_id=1&date=2026-11-03
{"code":200,"data":{"date":"2026-11-03","employee_id":1,"first_in":"2026-11-03 08:55:00","last_out":"2026-11-03 18:05:00","records":[{"check_time":"2026-11-03 08:55:00","check_type":"in","employee_id":1,"id":1},{"check_time":"2026-11-03 18:05:00","check_type":"out","employee_id":1,"id":2}]},"message":"操作成功"}

HTTP_STATUS=200
$ curl -X POST /api/employees (创建李四)
{"code":200,"data":{"created_at":"2026-11-03 11:38:09","department":"产品部","employee_no":"E002","id":2,"name":"李四"},"message":"员工创建成功"}

HTTP_STATUS=200
$ curl -X POST /api/checkins/out (未签到先签出)
{"code":400,"data":null,"message":"当天还没有签到，不能直接签出"}

HTTP_STATUS=400
$ curl -X DELETE /api/employees/2
{"code":200,"data":{"created_at":"2026-11-03 11:38:09","department":"产品部","employee_no":"E002","id":2,"name":"李四"},"message":"员工已删除"}

HTTP_STATUS=200
$ curl GET /api/employees/2 (删除后查询)
{"code":404,"data":null,"message":"员工不存在"}

HTTP_STATUS=404
